{
  "manifest_version": 3,
  "name": "PhishGuard — Real-Time Phishing Detector",
  "version": "1.0.0",
  "description": "AI-powered real-time phishing and malware URL detection",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "webNavigation",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html"
}
